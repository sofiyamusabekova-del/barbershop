{
  "name": "barbershop-monorepo",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "dev:miniapp": "npm run dev --workspace=apps/miniapp",
    "build:miniapp": "npm run build --workspace=apps/miniapp",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "build:api": "tsc --project apps/api/tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/session": "^11.1.4",
    "@prisma/client": "^5.22.0",
    "@twa-dev/sdk": "^8.0.2",
    "argon2": "^0.45.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "grammy": "^1.46.0",
    "lucide-react": "^1.54.0",
    "prisma": "^5.22.0",
    "zod": "^4.6.5"
  }
}
